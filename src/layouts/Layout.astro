---
const { title = "Association LCM" } = Astro.props;
---

<!doctype html>
<html lang="fr">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <link rel="icon" href="/favicon.ico" />
    <link
      href="https://fonts.googleapis.com/css2?family=Parisienne&display=swap"
      rel="stylesheet"
    />

    <style is:global>
      html {
        scroll-behavior: smooth;
        scroll-padding-top: 180px;
      }
      :root {
        --primary: #06031e;
        --background: #fff8f5;
        --text: #06031e;
        --accent: #03084c; /* couleur titre / séparateurs */
      }

      * {
        box-sizing: border-box;
      }

      body {
        margin: 0;
        font-family: Arial, sans-serif;
        background: var(--background);
        color: var(--text);
      }

      /* =========================
         HEADER (Bandeau haut)
         ========================= */
      header {
        background: var(--primary);
        display: flex;
        align-items: stretch;
        justify-content: space-between;
        padding: 0 2rem 0 0; /* collé à gauche */
        position: sticky;
        top: 0;
        z-index: 1000;
      }

      .logo-mini {
        height: 90px;
        width: auto;
        display: block;
        margin: 0;
      }

      .header-right {
        display: flex;
        flex-direction: column;
        align-items: flex-end;
        justify-content: space-between;
        padding: 2rem 0 0.5rem 0;
      }

      .location {
        color: rgba(255, 255, 255, 0.8);
        font-size: 0.85rem;
      }

      nav {
        display: flex;
        align-items: center;
        gap: 18px;
        flex-wrap: wrap;
        justify-content: flex-end;
      }

      nav a {
        color: white;
        text-decoration: none;
        font-weight: bold;
        white-space: nowrap;
      }

      nav a:hover {
        text-decoration: underline;
      }

      /* =========================
         Séparateur sous header
         ========================= */
      .top-separator {
        height: 10px;
        background: linear-gradient(to bottom, var(--accent), white);
        position: sticky;
        top: 90px;
        z-index: 999;
      }

      /* =========================
         MAIN
         ========================= */
      main {
        padding: 0;
      }

      /* =========================
   Animation Scroll
========================= */

      .scroll-reveal {
        opacity: 0;
        transform: translateY(60px);
        transition: all 0.9s ease;
      }

      .scroll-reveal.visible {
        opacity: 1;
        transform: translateY(0);
      }

      /* =========================================================
         BLOC 1 (A1 + B1)  = HERO
         ========================================================= */
      .hero {
        display: flex;
        align-items: center;
        justify-content: space-between;
        width: 100%;
        min-height: 70vh;
        background: white;
        padding: 1rem 1.2rem;
      }

      /* -------------------------
         BLOC A1 (Texte gauche)
         ------------------------- */
      .hero-left {
        flex: 1.6;
        min-width: 280px;
        max-width: none; /* un peu plus large pour remplir */
        display: flex;
        flex-direction: column;
        justify-content: flex-start;
        /*gap: 1.3rem;*/
        padding-top: 1.5rem;
        background: transparent;
      }

      /* (A1) styles du contenu texte */
      .intro-label {
        text-transform: uppercase;
        letter-spacing: 3px;
        font-size: 1.3rem;
        color: #03084c;
        margin: 0;
        padding-top: 1.5rem;
        padding-left: 20px;
      }

      .main-title {
        font-family: "Parisienne", cursive;
        font-size: 4.5rem; /* ↑ augmente bien l'impact */
        line-height: 1.05;
        color: var(--accent);
        padding-left: 20px;
        padding-top: 1.5rem;
      }

      .divider {
        width: 70px;
        height: 4px;
        background: var(--accent);
        margin: 1.6rem 0 0.8rem 0;
        margin-left: 20px;
      }

      .disciplines {
        /* font-weight: normal;*/
        font-family: "Parisienne", cursive;
        letter-spacing: 3px;
        margin: 0;
        color: #731e61;
        font-size: 2.2rem; /* ↑ plus grand */
        padding-top: 2.2rem;
        padding-left: 20px;
      }

      .age {
        font-weight: bold;
        letter-spacing: 2.2px;
        margin: 0;
        color: #731e61;
        font-size: 1.2rem; /* ↑ plus grand */
        padding-top: 1rem;
        padding-left: 20px;
      }

      /* IMPORTANT: on garde UNE seule règle .poetic (corrigée) */
      .poetic {
        margin: 0;
        font-style: italic;
        color: #666;
        font-size: 1.25rem; /* ← corrigé (remplace 1.2re3) */
        max-width: 560px;
        padding-top: 1.5rem;
        padding-left: 20px;
      }

      /* (Optionnel) si tu as encore des h1/h2 bruts ailleurs */
      .hero-left h1,
      .hero-left h2 {
        margin: 0;
      }

      /* -------------------------
         BLOC B1 (Image droite)
         ------------------------- */
      .hero-right {
        flex: 1;
        min-width: 260px;
        display: flex;
        align-items: center;
        justify-content: flex-end;
      }

      .affiche {
        width: min(600px, 100%); /* ↑ plus grande que 520px */
        height: auto;
        display: block;
        box-shadow:
          -12px 0 30px rgba(3, 8, 76, 0.45),
          12px 0 30px rgba(3, 8, 76, 0.25);
      }

      /* =========================
         Séparateur + Bloc 2 (vide)
         ========================= */
      .separator {
        height: 30px;
        background: #ffffff;
      }

      /* =========================
   ACCUEIL — MOT DU PRÉSIDENT
========================= */

      .president-home {
        padding: 4rem 2rem;
        background: linear-gradient(
          135deg,
          rgba(3, 8, 76, 0.98),
          rgba(115, 30, 97, 0.95)
        );
        color: white;
        text-align: center;
      }

      .president-home-content {
        max-width: 900px;
        margin: 0 auto;
      }

      .president-home-label {
        display: inline-block;
        margin: 0 0 1.5rem;
        padding: 0.45rem 1rem;

        border: 1px solid rgba(255, 255, 255, 0.45);
        border-radius: 999px;

        text-transform: uppercase;
        letter-spacing: 3px;
        font-size: 0.9rem;
        font-weight: bold;
      }

      .president-home-quote {
        margin: 0 auto;
        max-width: 820px;

        font-family: Arial, sans-serif;
        font-size: 1.3rem;
        font-style: normal;
        font-weight: normal;
        line-height: 1.75;
        color: white;
      }

      .president-home-link {
        display: inline-flex;
        align-items: center;
        gap: 0.6rem;

        margin-top: 2rem;
        padding: 0.85rem 1.6rem;

        background: white;
        color: #03084c;

        border-radius: 999px;

        font-weight: bold;
        text-decoration: none;

        transition:
          transform 0.25s ease,
          box-shadow 0.25s ease,
          background 0.25s ease;
      }

      .president-home-link:hover {
        transform: translateY(-3px);
        background: #fff8f5;
        box-shadow: 0 10px 25px rgba(0, 0, 0, 0.22);
      }

      .president-home-link span {
        transition: transform 0.25s ease;
      }

      .president-home-link:hover span {
        transform: translateX(4px);
      }

      @media (max-width: 700px) {
        .president-home {
          padding: 3rem 1.5rem;
        }

        .president-home-quote {
          font-size: 1.1rem;
        }
      }

      /* =========================
   BLOC 2 — ACTUALITÉS
========================= */

      .actus-section {
        width: 100%;
        position: relative;
        overflow: hidden;
      }

      .actus-slider {
        position: relative;
        width: 100%;
      }

      .actus-track {
        display: flex;
        transition: transform 0.6s ease;
      }

      .actus-slide {
        position: relative;
        min-width: 100%;
        padding: 5rem 2rem;
        text-align: center;
        color: white;
      }

      .actus-label {
        font-size: 1.5rem;
        letter-spacing: 3px;
        text-transform: uppercase;
        background: rgba(255, 255, 255, 0.15);
        padding: 6px 14px;
        border-radius: 20px;
        color: white;
      }

      .actus-top {
        position: absolute;
        top: 25px;
        left: 30px;
        right: 30px;

        display: flex;
        justify-content: space-between;
        align-items: center;

        z-index: 100;
        pointer-events: none;
      }

      .actus-more {
        pointer-events: auto;

        color: white;
        text-decoration: none;
        font-weight: bold;
        font-size: 0.95rem;

        padding: 8px 18px;

        border: 2px solid rgba(255, 255, 255, 0.6);
        border-radius: 999px;

        transition: all 0.3s ease;
      }

      .actus-more:hover {
        background: white;
        color: #03084c;
      }

      .slide1 {
        background: #731e61;
      }
      .slide2 {
        background: #03084c;
      }
      .slide3 {
        background: #141c87;
      }
      .slide4 {
        background: #c073af;
      }

      .actus-slide h2 {
        font-size: 2.5rem;
        margin-bottom: 1rem;
      }

      .actus-slide h3 {
        font-size: 1.8rem;
        margin-top: 0;
        margin-bottom: 1.5rem;
        font-weight: normal;
      }

      .actus-slide p {
        font-size: 1.2rem;
        max-width: 600px;
        margin: auto;
      }

      .actus-programme {
        display: flex;
        justify-content: center;
        gap: 2rem;
        margin-top: 2rem;
        flex-wrap: wrap;
      }

      .programme-item {
        background: rgba(255, 255, 255, 0.12);
        padding: 1.5rem;
        border-radius: 15px;
        min-width: 220px;
        max-width: 260px;
      }

      .programme-item h4 {
        margin: 0 0 0.8rem;
        font-size: 1.3rem;
        color: white;
      }

      .programme-item p {
        margin: 0;
        font-size: 1.05rem;
        line-height: 1.6;
        color: white;
      }

      /* Flèches */
      .arrow {
        position: absolute;
        top: 50%;
        transform: translateY(-50%);
        background: rgba(255, 255, 255, 0.2);
        border: none;
        font-size: 2rem;
        color: white;
        cursor: pointer;
        padding: 0.5rem 1rem;
        border-radius: 50%;
      }

      .arrow.left {
        left: 20px;
      }
      .arrow.right {
        right: 20px;
      }

      .arrow:hover {
        background: rgba(255, 255, 255, 0.4);
      }

      /* Points */
      .dots {
        text-align: center;
        margin-top: 1.5rem;
        position: absolute;
        bottom: 20px;
        width: 100%;
      }

      .dot {
        display: inline-block;
        width: 12px;
        height: 12px;
        margin: 0 6px;
        background: rgba(255, 255, 255, 0.4);
        border-radius: 50%;
        cursor: pointer;
      }

      .dot.active {
        background: white;
      }

      .cta-button {
        display: inline-block;
        margin-top: 2rem;
        padding: 0.9rem 2rem;
        background: white;
        color: #03084c;
        text-decoration: none;
        font-weight: bold;
        border-radius: 40px;
        transition: all 0.3s ease;
      }

      .cta-button:hover {
        background: #f2f2f2;
        transform: translateY(-3px);
        box-shadow: 0 8px 20px rgba(0, 0, 0, 0.25);
      }

      /* =========================
   BLOC 3 — CARTES
========================= */

      .bloc3 {
        display: flex;
        gap: 2rem;
        justify-content: center;
        padding: 5rem 2rem;
        background: #f9f9fb;
        flex-wrap: wrap;
      }

      .card {
        background: white;
        padding: 2.5rem 2rem;
        width: 320px;
        border-radius: 16px;
        box-shadow: 0 10px 30px rgba(0, 0, 0, 0.08);
        text-align: center;
        transition: all 0.3s ease;
      }

      .card:hover {
        transform: translateY(-8px);
        box-shadow: 0 18px 40px rgba(0, 0, 0, 0.12);
      }

      .card h3 {
        font-size: 1.8rem;
        margin-bottom: 1rem;
        color: var(--accent);
      }

      .card p {
        font-size: 1rem;
        color: #555;
        margin-bottom: 2rem;
      }

      .card-button {
        display: inline-block;
        padding: 0.7rem 1.8rem;
        background: var(--accent);
        color: white;
        text-decoration: none;
        border-radius: 30px;
        transition: all 0.3s ease;
      }

      .card-button:hover {
        background: #050d6e;
      }

      /* =========================
   BLOC 4 — CONTACT
========================= */

      .bloc4 {
        width: 100%;
        padding: 2.5rem 2rem;

        background: #03084c;
        color: white;
      }

      .contact-container {
        width: 100%;
        max-width: 1200px;
        margin: 0 auto;
      }

      .contact-label {
        display: inline-block;

        margin-bottom: 2rem;
        padding: 6px 14px;

        background: rgba(255, 255, 255, 0.15);

        border-radius: 20px;

        font-size: 1.5rem;
        letter-spacing: 3px;
        text-transform: uppercase;
      }

      /* Les 3 informations principales sur une ligne */

      .contact-grid {
        display: grid;
        grid-template-columns: 1.15fr 0.8fr 1.15fr;

        gap: 3rem;
        align-items: start;
      }

      .contact-item {
        display: flex;
        align-items: flex-start;
        gap: 12px;

        margin: 0;

        font-size: 1rem;
        line-height: 1.5;
      }

      .contact-item .icon {
        width: 24px;

        flex-shrink: 0;
        text-align: center;
      }

      .contact-item > div {
        display: flex;
        flex-direction: column;
      }

      .contact-item strong {
        margin-bottom: 0.2rem;

        font-size: 1.05rem;
      }

      .contact-item span {
        line-height: 1.5;
      }

      .contact-item a {
        margin-top: 0.25rem;
      }

      /* Partie mail / réseaux */
      .contact-general {
        display: flex;
        flex-direction: column;
      }

      .contact-email {
        margin-top: 0.8rem;
      }

      .contact-email .mail-icon {
        font-size: 1.2rem;
      }

      .mail-link {
        color: white;
        text-decoration: underline;
      }

      .mail-link:hover {
        opacity: 0.8;
      }

      .social-icons {
        display: flex;
        align-items: center;

        gap: 1.5rem;
      }

      .social-icon {
        width: 32px;
        height: 32px;

        display: flex;
        align-items: center;
        justify-content: center;

        transition:
          transform 0.3s ease,
          opacity 0.3s ease;
      }

      .social-icon svg {
        width: 100%;
        height: 100%;
      }

      .social-icon:hover {
        transform: scale(1.15);
        opacity: 0.8;
      }

      @media (max-width: 800px) {
        .bloc4 {
          padding: 2.5rem 1.5rem;
        }

        .contact-grid {
          grid-template-columns: 1fr;
          gap: 1.5rem;
        }
      }

      /* =========================
   PAGE ÉQUIPE — BANDEAU
========================= */

      .eq-hero {
        background: white;
        padding: 1.5rem 1.2rem 0;
      }

      .eq-banner {
        max-width: 1100px;
        margin: 0.8rem auto 0;
        padding: 0.9rem 1.2rem;

        background: #731e61;
        color: white;

        border-radius: 14px;
        box-shadow: 0 12px 30px rgba(115, 30, 97, 0.35);

        text-align: center;
      }

      .eq-banner p {
        margin: 0;

        font-family: "Parisienne", cursive;
        font-size: 2.2rem;
        letter-spacing: 1px;
      }

      /* =========================
   PAGE ÉQUIPE — PRÉSIDENT
========================= */

      .eq-president {
        width: calc(100% - 4rem);
        max-width: 1100px;
        margin: 2rem auto 0;
        padding: 0 0 6rem;

        background: white;
      }

      /* Encadré "Le mot du président" */

      .eq-president-label {
        width: 100%;
        margin-bottom: 3rem;
        padding: 1rem 1.5rem;

        background: linear-gradient(
          135deg,
          rgba(3, 8, 76, 0.98),
          rgba(115, 30, 97, 0.95)
        );

        color: white;

        border-radius: 12px;
        box-shadow: 0 10px 25px rgba(3, 8, 76, 0.2);

        font-family: Arial, sans-serif;
        font-size: 1.3rem;
        font-weight: bold;
        letter-spacing: 3px;
        text-transform: uppercase;
        text-align: center;
      }

      /* Partie photo + identité */

      .eq-president-header {
        display: grid;
        grid-template-columns: 280px minmax(0, 1fr);
        align-items: center;
        gap: 3rem;

        max-width: 900px;
        margin: 0 auto 3rem;
      }

      .eq-president-photo-wrap {
        display: flex;
        align-items: center;
        justify-content: center;
      }

      .eq-president-photo {
        display: block;

        width: 100%;
        max-width: 280px;
        height: auto;

        border-radius: 20px;
        box-shadow: 0 18px 45px rgba(0, 0, 0, 0.15);
      }

      .eq-president-identity {
        text-align: left;
      }

      .eq-president-name {
        margin: 0;

        font-family: "Parisienne", cursive;
        font-size: 3.4rem;
        line-height: 1.1;
        color: var(--accent);
      }

      .eq-president-role {
        margin-top: 0.7rem;

        color: #555;

        font-size: 0.95rem;
        font-weight: bold;
        line-height: 1.5;
        letter-spacing: 2px;
        text-transform: uppercase;
      }

      .eq-president-divider {
        width: 70px;
        height: 4px;
        margin-top: 1.5rem;

        background: #731e61;
        border-radius: 999px;
      }

      /* Texte du président */

      .eq-president-text {
        width: 100%;
        max-width: 1000px;
        margin: 0 auto;

        color: #444;

        font-size: 1.08rem;
        line-height: 1.65;

        text-align: justify;
        text-justify: inter-word;
      }

      /*
 * Les paragraphes remplacent les <br>.
 * Cette marge contrôle précisément l'espace entre les blocs.
 */
      .eq-president-text p {
        margin: 0 0 0.75rem;
      }

      .eq-president-text p:last-child {
        margin-bottom: 0;
      }

      .eq-president-highlight {
        margin: 1.2rem 0 !important;
        padding: 1rem 1.4rem;

        background: rgba(115, 30, 97, 0.07);

        border-left: 4px solid #731e61;
        border-radius: 8px;

        color: #333;
        font-style: italic;
      }

      /* Présentation de Jo */

      .eq-president-quote {
        margin: 2rem 0 0;
        padding-left: 1.2rem;

        color: #666;

        border-left: 3px solid var(--accent);

        font-size: 1.05rem;
        font-style: italic;
        line-height: 1.7;

        text-align: justify;
        text-justify: inter-word;
      }

      /* Responsive */

      @media (max-width: 800px) {
        .eq-president {
          width: 100%;
          padding: 0 1.5rem 5rem;
        }

        .eq-president-label {
          margin-bottom: 2.5rem;

          font-size: 1.05rem;
          letter-spacing: 2px;
        }

        .eq-president-header {
          grid-template-columns: 1fr;
          gap: 2rem;

          margin-bottom: 2.5rem;
        }

        .eq-president-photo {
          max-width: 250px;
        }

        .eq-president-identity {
          text-align: center;
        }

        .eq-president-name {
          font-size: 2.8rem;
        }

        .eq-president-divider {
          margin: 1.5rem auto 0;
        }

        /*
   * La justification donne parfois de grands espaces sur les petits écrans.
   */
        .eq-president-text,
        .eq-president-quote {
          text-align: left;
        }
      }

      /* =========================
   PAGE ÉQUIPE — CHRIS ET CLOÉ
========================= */

      .eq-member {
        display: grid;
        grid-template-columns: 320px minmax(0, 1fr);
        align-items: center;
        gap: 3.5rem;

        width: calc(100% - 4rem);
        max-width: 1200px;
        margin: 0 auto;
        padding: 5rem 0;

        background: #f9f9fb;
      }

      /*
 * Espace supplémentaire entre Chris et Cloé.
 */
      .eq-member + .eq-member {
        margin-top: 4rem;
        padding-top: 7rem;

        border-top: 1px solid rgba(3, 8, 76, 0.12);
      }

      .eq-member-left {
        display: flex;
        align-items: center;
        justify-content: center;
      }

      .eq-member-photo {
        display: block;

        width: 100%;
        max-width: 320px;
        height: auto;

        border-radius: 20px;
        box-shadow: 0 18px 45px rgba(0, 0, 0, 0.15);
      }

      .eq-member-right {
        width: 100%;
        max-width: 750px;
      }

      .eq-member-name {
        margin: 0;

        font-family: "Parisienne", cursive;
        font-size: 3rem;
        line-height: 1.1;
        color: var(--accent);
      }

      .eq-member-role {
        margin-top: 0.5rem;

        color: #555;

        font-size: 0.9rem;
        text-transform: uppercase;
        letter-spacing: 2px;
      }

      .eq-member-divider {
        width: 60px;
        height: 4px;
        margin: 1.5rem 0;

        background: var(--accent);
      }

      .eq-member-text {
        margin: 0;

        color: #444;

        font-size: 1.1rem;
        line-height: 1.7;

        text-align: justify;
        text-justify: inter-word;
      }

      .eq-member-quote {
        margin: 2rem 0 0;
        padding-left: 1.2rem;

        color: #666;

        border-left: 3px solid var(--accent);

        font-size: 1.05rem;
        font-style: italic;
        line-height: 1.7;

        text-align: justify;
        text-justify: inter-word;
      }

      /* =========================
   PAGE ÉQUIPE — RESPONSIVE
========================= */

      @media (max-width: 900px) {
        .eq-member {
          grid-template-columns: 1fr;
          gap: 2.5rem;

          width: 100%;
          padding: 4rem 1.5rem;

          text-align: center;
        }

        .eq-member + .eq-member {
          margin-top: 2rem;
          padding-top: 5rem;
        }

        .eq-member-right {
          max-width: 750px;
          margin: 0 auto;
        }

        .eq-member-divider {
          margin: 1.5rem auto;
        }

        .eq-member-text,
        .eq-member-quote {
          text-align: left;
        }

        .eq-president {
          padding: 3rem 1.5rem 5rem;
        }
      }

      @media (max-width: 600px) {
        .eq-banner p {
          font-size: 1.8rem;
        }

        .eq-president-name,
