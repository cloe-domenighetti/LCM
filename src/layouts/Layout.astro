      /* =========================
   PAGE PLANNING — HERO
========================= */
      .planning-hero {
        max-width: 1200px;
        margin: 0 auto;
        padding: 3rem 2rem 1.5rem;
        text-align: left;
      }

      .planning-title {
        font-family: "Parisienne", cursive;
        font-size: 4rem;
        margin: 0;
        color: var(--accent);
      }

      .planning-subtitle {
        margin-top: 0.8rem;
        font-size: 1.1rem;
        color: #555;
        max-width: 720px;
        line-height: 1.6;
      }

      /* =========================
   PAGE PLANNING — INTRODUCTION
========================= */

      /* =========================
   PAGE PLANNING — NAVIGATION
========================= */

      .planning-navigation {
        max-width: 1200px;
        margin: 0 auto;
        padding: 0 2rem 1.5rem;

        display: flex;
      }

      .planning-navigation-button {
        display: inline-block;

        padding: 0.75rem 1.3rem;

        background: rgba(115, 30, 97, 0.1);
        color: #731e61;

        border: 1px solid rgba(115, 30, 97, 0.3);
        border-radius: 999px;

        font-weight: bold;
        text-decoration: none;

        transition:
          background 0.25s ease,
          color 0.25s ease,
          transform 0.25s ease,
          box-shadow 0.25s ease;
      }

      .planning-navigation-button:hover {
        background: #731e61;
        color: white;

        transform: translateY(-2px);
        box-shadow: 0 8px 20px rgba(115, 30, 97, 0.2);
      }

      .planning-intro {
        max-width: 1200px;
        margin: 0 auto;
        padding: 0 2rem 2rem;
      }

      .planning-season {
        display: flex;
        align-items: center;
        gap: 1.5rem;

        padding: 1.25rem 1.5rem;

        background: white;
        border: 1px solid rgba(3, 8, 76, 0.08);
        border-radius: 16px;

        box-shadow: 0 10px 28px rgba(3, 8, 76, 0.07);
      }

      .planning-season-label {
        flex-shrink: 0;

        padding: 0.55rem 1rem;

        background: rgba(115, 30, 97, 0.11);
        color: #731e61;

        border-radius: 999px;

        font-size: 0.9rem;
        font-weight: bold;
        letter-spacing: 1px;
        text-transform: uppercase;
      }

      .planning-season p {
        margin: 0;

        color: #555;

        font-size: 1rem;
        line-height: 1.6;
      }

      /* =========================
   PAGE PLANNING — CARTES PAR JOUR
========================= */

      .schedule-grid {
        display: grid;
        grid-template-columns: 1fr;
        gap: 2rem;

        max-width: 1200px;
        margin: 0 auto;
        padding: 1rem 2rem 5rem;
      }

      .schedule-day {
        overflow: hidden;

        background: white;

        border: 1px solid rgba(3, 8, 76, 0.08);
        border-radius: 20px;

        box-shadow: 0 14px 36px rgba(3, 8, 76, 0.09);

        transition:
          transform 0.25s ease,
          box-shadow 0.25s ease;
      }

      .schedule-day:hover {
        transform: translateY(-4px);
        box-shadow: 0 20px 45px rgba(3, 8, 76, 0.13);
      }

      /* En-tête coloré de chaque jour */

      .schedule-day-header {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 2rem;

        padding: 1.5rem 1.8rem;

        background: linear-gradient(
          135deg,
          rgba(3, 8, 76, 0.98),
          rgba(115, 30, 97, 0.95)
        );

        color: white;
      }

      .schedule-day-label {
        margin: 0 0 0.35rem;

        color: rgba(255, 255, 255, 0.75);

        font-size: 0.78rem;
        font-weight: bold;
        letter-spacing: 2px;
        text-transform: uppercase;
      }

      .schedule-day-header h2 {
        margin: 0;

        font-family: Arial, sans-serif;
        font-size: 2rem;
        line-height: 1.1;
      }

      .schedule-day-count {
        flex-shrink: 0;

        padding: 0.5rem 0.9rem;

        background: rgba(255, 255, 255, 0.14);

        border: 1px solid rgba(255, 255, 255, 0.3);
        border-radius: 999px;

        font-size: 0.85rem;
        font-weight: bold;
      }

      /* En-tête du tableau */

      .schedule-table-header,
      .schedule-table-header,
      .schedule-row {
        display: grid;

        grid-template-columns:
          minmax(130px, 0.9fr)
          minmax(150px, 1.2fr)
          minmax(100px, 0.7fr)
          minmax(180px, 1.3fr)
          minmax(100px, 0.7fr);

        align-items: center;
        column-gap: 1.5rem;
      }
      .schedule-table-header {
        padding: 0.9rem 1.8rem;

        background: rgba(3, 8, 76, 0.05);
        color: #555;

        border-bottom: 1px solid rgba(3, 8, 76, 0.08);

        font-size: 0.78rem;
        font-weight: bold;
        letter-spacing: 1.3px;
        text-transform: uppercase;
      }

      .schedule-location {
        color: #555;
        font-size: 0.95rem;
        line-height: 1.4;
      }

      /* Lignes du planning */

      .schedule-row {
        min-height: 78px;
        padding: 1rem 1.8rem;

        border-bottom: 1px solid rgba(3, 8, 76, 0.08);
      }

      .schedule-row:last-child {
        border-bottom: none;
      }

      .schedule-row:hover {
        background: rgba(115, 30, 97, 0.035);
      }

      .schedule-time {
        color: var(--accent);

        font-size: 1rem;
        font-weight: bold;
      }

      .schedule-course {
        display: flex;
        flex-direction: column;
        gap: 0.25rem;

        color: #333;
      }

      .schedule-course strong {
        font-size: 1.02rem;
      }

      .schedule-course span {
        color: #666;
        font-size: 0.9rem;
      }

      .schedule-capacity {
        color: #555;
        font-size: 0.95rem;
      }

      /* Pastille de l’intervenant */

      .schedule-teacher {
        justify-self: start;

        min-width: 72px;
        padding: 0.45rem 0.85rem;

        border-radius: 999px;

        font-size: 0.9rem;
        font-weight: bold;
        text-align: center;
      }

      .teacher-cloe {
        background: rgba(115, 30, 97, 0.12);
        color: #731e61;
      }

      .teacher-chris {
        background: rgba(3, 8, 76, 0.1);
        color: #03084c;
      }

      /* =========================
   PAGE PLANNING — INFORMATIONS
========================= */

      .planning-notes {
        padding: 0 2rem 5rem;
      }

      .planning-note-card {
        max-width: 900px;
        margin: 0 auto;
        padding: 2.2rem;

        background: white;

        border: 1px solid rgba(3, 8, 76, 0.08);
        border-left: 5px solid #731e61;
        border-radius: 16px;

        box-shadow: 0 12px 30px rgba(3, 8, 76, 0.08);

        text-align: center;
      }

      .planning-note-card h2 {
        margin: 0 0 1rem;

        color: var(--accent);

        font-size: 1.8rem;
      }

      .planning-note-card p {
        max-width: 700px;
        margin: 0 auto;

        color: #555;

        font-size: 1.05rem;
        line-height: 1.7;
      }

      .planning-cta {
        display: inline-block;

        margin-top: 1.6rem;
        padding: 0.85rem 1.5rem;

        background: #731e61;
        color: white;

        border-radius: 999px;

        font-weight: bold;
        text-decoration: none;

        transition:
          transform 0.25s ease,
          box-shadow 0.25s ease;
      }

      .planning-cta:hover {
        transform: translateY(-3px);
        box-shadow: 0 10px 24px rgba(115, 30, 97, 0.28);
      }

      /* =========================
   PAGE PLANNING — LIEUX
========================= */

      #infos-pratiques {
        scroll-margin-top: 145px;
      }

      .planning-locations {
        max-width: 1200px;
        margin: 0 auto;
        padding: 0 2rem 5rem;
      }

      .planning-locations-heading {
        max-width: 850px;
        margin-bottom: 2rem;
      }

      .planning-locations-eyebrow {
        display: inline-block;

        margin-bottom: 0.6rem;

        color: #731e61;

        font-size: 0.82rem;
        font-weight: bold;
        letter-spacing: 2px;
        text-transform: uppercase;
      }

      .planning-locations-heading h2 {
        margin: 0;

        color: var(--accent);

        font-size: 2.3rem;
      }

      .planning-locations-heading p {
        margin: 0.8rem 0 0;

        color: #555;

        font-size: 1.05rem;
        line-height: 1.7;
      }

      /* 2 cartes côte à côte */

      .planning-locations-grid {
        display: grid;
        grid-template-columns: repeat(2, minmax(0, 1fr));
        gap: 2rem;
      }

      .planning-location-card {
        overflow: hidden;

        display: flex;
        flex-direction: column;

        background: white;

        border: 1px solid rgba(3, 8, 76, 0.08);
        border-radius: 20px;

        box-shadow: 0 14px 36px rgba(3, 8, 76, 0.09);
      }

      .planning-location-content {
        flex: 1;
        padding: 1.8rem;
      }

      .planning-location-badge {
        display: inline-block;

        margin-bottom: 1rem;
        padding: 0.45rem 0.8rem;

        background: rgba(115, 30, 97, 0.1);
        color: #731e61;

        border-radius: 999px;

        font-size: 0.8rem;
        font-weight: bold;
      }

      .planning-location-content h3 {
        margin: 0 0 1rem;

        color: var(--accent);

        font-size: 1.5rem;
      }

      .planning-location-content p {
        color: #555;
        line-height: 1.65;
      }

      .planning-location-detail {
        padding: 1rem 1.2rem;

        background: rgba(3, 8, 76, 0.045);

        border-radius: 10px;
      }

      .planning-location-warning {
        color: #666 !important;

        font-size: 0.9rem !important;
        font-style: italic;
      }

      .planning-map-link {
        color: #731e61;

        font-weight: bold;
        text-decoration: none;
      }

      .planning-map-link:hover {
        text-decoration: underline;
      }

      .planning-map {
        width: 100%;
        height: 330px;

        border-top: 1px solid rgba(3, 8, 76, 0.08);
      }

      .planning-map iframe {
        display: block;

        width: 100%;
        height: 100%;

        border: 0;
      }

      .planning-locations-action {
        margin-top: 2.5rem;

        text-align: center;
      }

      /* =========================
   PAGE PLANNING — RESPONSIVE
========================= */

      @media (max-width: 800px) {
        .planning-season {
          flex-direction: column;
          align-items: flex-start;
          gap: 1rem;
        }

        .schedule-grid {
          padding: 1rem 1.5rem 4rem;
        }

        .schedule-table-header {
          display: none;
        }

        .schedule-row {
          grid-template-columns: 1fr auto;

          grid-template-areas:
            "time teacher"
            "course course"
            "capacity capacity"
            "location location";

          gap: 0.6rem 1rem;

          padding: 1.3rem 1.4rem;
        }

        .schedule-time {
          grid-area: time;
        }

        .schedule-course {
          grid-area: course;
        }

        .schedule-capacity {
          grid-area: capacity;
        }

        .schedule-location {
          grid-area: location;

          margin-top: 0.2rem;

          color: #666;
          font-size: 0.9rem;
        }

        .schedule-location::before {
          content: "📍 ";
        }

        .schedule-teacher {
          grid-area: teacher;
          justify-self: end;
        }

        .planning-navigation {
          padding: 0 1.5rem 1.5rem;
        }

        .planning-locations {
          padding: 0 1.5rem 4rem;
        }

        .planning-locations-grid {
          grid-template-columns: 1fr;
        }

        .planning-map {
          height: 300px;
        }
      }

      @media (max-width: 520px) {
        .planning-hero {
          padding: 2.5rem 1.5rem 1rem;
        }

        .planning-title {
          font-size: 3.1rem;
        }

        .planning-intro {
          padding: 0 1.5rem 1.5rem;
        }

        .schedule-day-header {
          align-items: flex-start;
          gap: 1rem;

          padding: 1.3rem 1.4rem;
        }

        .schedule-day-header h2 {
          font-size: 1.7rem;
        }

        .schedule-day-count {
          font-size: 0.75rem;
        }

        .planning-notes {
          padding: 0 1.5rem 4rem;
        }

        .planning-note-card {
          padding: 1.7rem 1.4rem;
        }
      }

