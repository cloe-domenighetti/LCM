    </footer>

    <script>
      const track = document.querySelector<HTMLElement>(".actus-track");
      const slides = document.querySelectorAll<HTMLElement>(".actus-slide");
      const dotsContainer = document.querySelector<HTMLElement>(".dots");
      const prevBtn = document.querySelector<HTMLButtonElement>(".arrow.left");
      const nextBtn = document.querySelector<HTMLButtonElement>(".arrow.right");

      if (track && slides.length > 0 && dotsContainer && prevBtn && nextBtn) {
        let index = 0;
        const dots: HTMLElement[] = [];

        slides.forEach((_, i) => {
          const dot = document.createElement("span");

          dot.classList.add("dot");

          if (i === 0) {
            dot.classList.add("active");
          }

          dot.addEventListener("click", () => {
            index = i;
            updateSlider();
          });

          dotsContainer.appendChild(dot);
          dots.push(dot);
        });

        function updateSlider() {
          if (!track) return;

          track.style.transform = `translateX(-${index * 100}%)`;

          dots.forEach((dot) => {
            dot.classList.remove("active");
          });

          const activeDot = dots[index];

          if (activeDot) {
            activeDot.classList.add("active");
          }
        }

        nextBtn.addEventListener("click", () => {
          index = (index + 1) % slides.length;
          updateSlider();
        });

        prevBtn.addEventListener("click", () => {
          index = (index - 1 + slides.length) % slides.length;
          updateSlider();
        });
      }
    </script>
    <script>
      const revealElements =
        document.querySelectorAll<HTMLElement>(".scroll-reveal");

      const actualitesPage =
        document.querySelector<HTMLElement>(".actualites-page");

      const planningPage =
        document.querySelector<HTMLElement>(".planning-page");

      const tarifsPage = document.querySelector<HTMLElement>(".tarifs-page");
      /*
       * Sur la page Actualités, tout le contenu apparaît en même temps,
       * dès l'ouverture de la page.
       */
      if (actualitesPage) {
        requestAnimationFrame(() => {
          actualitesPage.classList.add("visible");
        });
      }

      if (planningPage) {
        requestAnimationFrame(() => {
          planningPage.classList.add("visible");
        });
      }

      if (tarifsPage) {
        requestAnimationFrame(() => {
          tarifsPage.classList.add("visible");
        });
      }

      const observer = new IntersectionObserver(
        (entries) => {
          entries.forEach((entry) => {
            if (entry.isIntersecting) {
              entry.target.classList.add("visible");
            } else {
              entry.target.classList.remove("visible");
            }
          });
        },
        {
          threshold: 0.25,
        },
      );

      revealElements.forEach((element) => {
        /*
         * La page Actualités est déjà animée globalement.
         * Elle ne doit pas être surveillée à nouveau.
         */
        if (
          element === actualitesPage ||
          element === planningPage ||
          element === tarifsPage
        ) {
          return;
        }
        observer.observe(element);
      });
    </script>

    <script>
      const progressFill = document.querySelector<HTMLElement>(
        ".scroll-progress-fill",
      );

      const progressThumb = document.querySelector<HTMLElement>(
        ".scroll-progress-thumb",
      );

      function updateScrollProgress() {
        const scrollTop = window.scrollY;

        const scrollableHeight =
          document.documentElement.scrollHeight - window.innerHeight;

        const progress =
          scrollableHeight > 0 ? scrollTop / scrollableHeight : 0;

        const boundedProgress = Math.min(Math.max(progress, 0), 1);
        const progressPercentage = boundedProgress * 100;

        if (progressFill) {
          progressFill.style.height = `${progressPercentage}%`;
        }

        if (progressThumb) {
          progressThumb.style.top = `${progressPercentage}%`;
        }
      }

      window.addEventListener("scroll", updateScrollProgress, {
        passive: true,
      });

      window.addEventListener("resize", updateScrollProgress);

      updateScrollProgress();
    </script>

    <script>
      const menuToggle =
        document.querySelector<HTMLButtonElement>(".menu-toggle");
      const headerRight = document.querySelector<HTMLElement>(".header-right");

      if (menuToggle && headerRight) {
        menuToggle.addEventListener("click", () => {
          const isOpen = headerRight.classList.toggle("open");

          menuToggle.setAttribute("aria-expanded", String(isOpen));
          menuToggle.textContent = isOpen ? "✕" : "☰";
        });

        headerRight.querySelectorAll("a").forEach((link) => {
          link.addEventListener("click", () => {
            headerRight.classList.remove("open");
            menuToggle.setAttribute("aria-expanded", "false");
            menuToggle.textContent = "☰";
          });
        });
      }
    </script>
  </body>
</html>
