---
import Layout from "../layouts/Layout.astro";
---

<Layout title="Accueil - LCM">
  <!-- BLOC1: HERO, BLOC A1 et B1-->
  <section id="accueil" class="hero scroll-reveal">
    <div class="hero-left">
		<h1 class="main-title">L'art de la Comédie Musicale</h1>
		<h2 class="intro-label">École à Saint-Maximin-la-Sainte-Baume (83)</h2>
		<div class="divider"></div>
		<h2 class="disciplines"> Chant · Théâtre · Chorégraphie</h2>
		<h2 class="age"> Enfants · Ados · Adultes</h2>
		<p class="poetic"> De l'ombre à la lumière ✨ </p> 
			
		</p>
	
	</div>

    <div class="hero-right">
		 <img class="affiche" src="/images/logo.jpeg" alt="Affiche LCM" />
	</div>
  </section>

  <!-- Démarcation blanche (séparateur) -->
  <div class="separator"></div>

    <!-- BLOC2: Actus -->

<section id="actualites" class="actus-section scroll-reveal">

  <div class="actus-top">
    <div class="actus-label">Actualités</div>

    <a href="/actualites" class="actus-more">
        En savoir plus 🔎 →
    </a>
</div>

  <div class="actus-slider">

    <div class="actus-track">

  <!-- 22 aout -->
      <div class="actus-slide slide1">
          <h2> Portes Ouvertes · Masterclass · Spectacle 🎤🎭<br></h2>
          <h3> <b>· Samedi 22 Aout 2026 - Salle des Fêtes ·</b></h3>
          <p> 🚪 Portes ouvertes : 8h30 - 12h30 <br>
            🎓 Masterclass "Les résonnateurs" : 13h30 - 18h30 <br>
            🎤 Spectacle "Les plus belles comédies musicales" : 20h30
        </p>
        </div>

  <!-- masterclass 22 aout -->
      <div class="actus-slide slide2">
          <h2> Masterclass "Les résonnateurs" 🎓<br></h2>
          <h3> <b>· Samedi 22 Aout 2026 · 13h30 - 18h30 · Salle des Fêtes ·</b></h3>
          <p> <b>Découvrez le pouvoir des résonnateurs ! </b><br>
            Explorez les secrets de la résonnance vocale et découvrez comment votre corps
            devient un véritable instrument avec notre professeur Chris Roger !
        </p>
                <a href="/tarifs" class="cta-button">
			Je m'inscris à la Masterclass 🎉
		</a>
        </div>

  <!-- Spectacle 22 aout -->
      <div class="actus-slide slide3">
          <h2> Spectacle : Les plus belles comédies musicales 🎤🎭<br>
          <h3> <b>· Samedi 22 Aout 2026 - 20h30 - Salle des Fêtes ·</b></h3>
          <p> <b>La troupe LCM monte sur scène ! </b> <br>
          <br>
          Venez découvrir la troupe LCM lors d'une soirée placée sous le signe
          de la musique, su spectacle, de l'émotion et du partage. <br>
          <br>
          <b> Entrée libre · Petite restauration sur place </b>
        </p>
        </div>

  <!-- Forum des assos -->
      <div class="actus-slide slide4">
		      <h2>Forum des associations ✨</h2>
          <h3> <b>· Samedi 6 eptembre 2026 </b></h3>
          <p><b>RDV au forum des asso de Saint-Maximin pour découvrir LCM et rencontrer notre équipe ! </p> </b><br>
          <br>
          -- Horaire et lieu à venir --
	    </div>

  <!-- Inscriptions ouvertes -->
      <div class="actus-slide slide1">
		      <h2>Inscriptions 2026 ouvertes 🤩</h2>
          <p><b>Les inscriptions pour la saison 2026 sont officiellement ouvertes 💖</p> </b><br>
          <p>Vous hésitez encore ? Venez participer à notre masterclass et/ou assister au spectacle
            des élèves de LCM le 22/08 ou bien nous rencontrer au forum des assos le 06/09 !</p>
          <a href="/tarifs" class="cta-button">
			      Je m'inscris 🎉
		      </a>
	    </div>

<!-- A venir -->

      <div class="actus-slide slide2">
		<h2>Et bien d'autres évenènements à venir ...</h2>
        <p><b>De nombreux projets en cours de préparation ! </b><br>
          <br>
          Ateliers, théatre, chorégraphie, création de spectacles, masterclass, stages ... <br>
          <br>
          <h3>Stay tuned 😉</h3>
        </p>
      </div>

    </div>

    <button class="arrow left">&#10094;</button>
    <button class="arrow right">&#10095;</button>

    <div class="dots"></div>

  </div>

</section>

    <!-- BLOC3: Cartes pages -->

<section id="presentation" class="bloc3 scroll-reveal">

  <div class="card">
    <h3>Nos Cours</h3>
    <p>
      Découvrez nos cours de comédie musicale alliant chant, danse et théâtre,
      adaptés à tous les niveaux.
    </p>
    <a href="/planning" class="card-button">Découvrir</a>
  </div>

  <div class="card">
    <h3>Notre équipe</h3>
    <p>
      Une équipe passionnée et professionnelle pour accompagner chaque élève
      avec enthousiasme et bienveillance.
    </p>
    <a href="/equipe" class="card-button">En savoir plus</a>
  </div>

  <div class="card">
    <h3>Tarifs & inscriptions</h3>
    <p>
      Retrouvez toutes les informations pratiques pour rejoindre LCM et vivre
      l’expérience de la scène.
    </p>
    <a href="/tarifs" class="card-button">Je m'inscris</a>
  </div>

</section>

    <!-- BLOC4: Contact -->

<section id="contact" class="bloc4 scroll-reveal">

<div class="bloc4-left">
  <div class="map-embed">
    <iframe
      src="https://www.google.com/maps/embed?pb=!1m18!1m12!1m3!1d5792.685421026857!2d5.852465215093448!3d43.45344188417966!2m3!1f0!2f0!3f0!3m2!1i1024!2i768!4f13.1!3m3!1m2!1s0x12c9702815b63b0f%3A0x512551ec03230eec!2sMairie%20de%20Saint-Maximin-la-Sainte-Baume%2083470!5e0!3m2!1sfr!2sfr!4v1771200622867!5m2!1sfr!2sfr"
      allowfullscreen
      loading="lazy"
      referrerpolicy="no-referrer-when-downgrade"
      title="Mairie de Saint-Maximin-la-Sainte-Baume"
    ></iframe>
  </div>
</div>

  <div class="bloc4-right">

    <div class="contact-label">Contact & Infos</div>

<div class="contact-item">
  <span class="icon">📍</span>
  <span>
    Adresse à venir<br>
    XXX adresse à venir<br>
    83470 Saint-Maximin-la-Sainte-Baume
  </span>
</div>

<div class="contact-item">
  <span class="icon">📞</span>
  <span>
    06 52 92 29 35
  </span>
</div>

<div class="contact-item">
  <span class="icon">📧</span>
  <span>
    <a href="mailto:lcm.spectacle@gmail.com" class="mail-link">
      lcm.spectacle@gmail.com
    </a>
  </span>
</div>

<div class="social-icons">

  <a href="#" target="_blank" aria-label="Instagram" class="social-icon">
