---
import Layout from "../layouts/Layout.astro";
---

<Layout title="L'équipe - LCM">
  <!-- BLOC EQ.1 -->
  <section class="eq-hero scroll-reveal">
    <div class="eq-photo-wrap">
      <img
        src="/images/equipe.jpg"
        alt="Photo de l’équipe LCM"
        class="eq-photo"
        loading="eager"
      />
    </div>

    <div class="eq-banner">
      <p>Se découvrir, se dépasser, transmettre, s’amuser</p>
    </div>
  </section>

  <!-- BLOC EQ.2 -->
  <section class="eq2 scroll-reveal">
    <!-- EQ.A2 -->
    <div class="eq2-left">
      <img
        src="/images/equipe/Jo.jpeg"
        alt="Jo, président de LCM Spectacle"
        class="president-photo"
        loading="eager"
      />
    </div>

    <!-- EQ.B2 -->
    <div class="eq2-right">
      <h2 class="eq2-name">Joan-Terence Gastaldi</h2>
      <div class="eq2-role">
        Président · Direction techniqu et organisation générale
      </div>

      <div class="eq2-divider"></div>

      <p class="eq2-text">
        Passionné par la scène et la transmission artistique, Chris accompagne
        chaque élève dans le développement de sa confiance, de sa créativité et
        de son expression personnelle. Son approche allie exigence,
        bienveillance et plaisir du spectacle.
      </p>

      <p class="eq2-quote">
        "J'ai commencé la scène très jeune, animé par l’envie de partager
        l’émotion du spectacle. Après plusieurs années à enseigner, je me lance
        aujourd’hui dans la création d’une association pour transmettre cette
        passion et faire vivre la comédie musicale à tous."
      </p>
    </div>
  </section>

  <!-- EQ.B2 -->
  <div class="eq2-right">
    <h2 class="eq2-name">Joan-Terence Gastaldi</h2>
    <div class="eq2-role">
      Président · Direction techniqu et organisation générale
    </div>

    <div class="eq2-divider"></div>

    <p class="eq2-text">
      Passionné par la scène et la transmission artistique, Chris accompagne
      chaque élève dans le développement de sa confiance, de sa créativité et de
      son expression personnelle. Son approche allie exigence, bienveillance et
      plaisir du spectacle.
    </p>

    <p class="eq2-quote">
      "J'ai commencé la scène très jeune, animé par l’envie de partager
      l’émotion du spectacle. Après plusieurs années à enseigner, je me lance
      aujourd’hui dans la création d’une association pour transmettre cette
      passion et faire vivre la comédie musicale à tous."
    </p>
  </div>
</Layout>

<!-- BLOC EQ.3 -->
<section class="eq3 scroll-reveal">
  <!-- EQ.A3 (Texte) -->
  <div class="eq3-left">
    <h2 class="eq3-name">Laurent JeSaisPas</h2>
    <div class="eq3-role">Enseignant</div>

    <div class="eq3-divider"></div>

    <p class="eq3-text">
      Artiste polyvalent et passionné, Laurent accompagne les élèves dans le
      développement de leur présence scénique, de leur énergie et de leur
      précision artistique. Son enseignement repose sur la rigueur, la
      progression et le plaisir du travail collectif.
    </p>

    <p class="eq3-quote">
      "La scène est un espace de liberté. J’aime transmettre cette énergie et
      aider chacun à trouver sa place sous les projecteurs."
    </p>
  </div>

  <!-- EQ.B3 (Photo) -->
  <div class="eq3-right">
    <img
      src="/images/laurent.jpg"
      alt="Laurent - Enseignant LCM"
      class="eq3-photo"
    />
  </div>
</section>
