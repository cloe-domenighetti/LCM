---
import Layout from "../layouts/Layout.astro";
---

<Layout title="Cours & planning - LCM">
  <div class="planning-page scroll-reveal">
    <!-- =========================
         EN-TÊTE DE LA PAGE
    ========================== -->

    <section class="planning-hero">
      <h1 class="planning-title">Cours & planning</h1>

      <p class="planning-subtitle">
        Découvrez les créneaux proposés par LCM Spectacle pour la saison
        2026-2027.
      </p>
    </section>

    <!-- =========================
         INFORMATION SAISON
    ========================== -->

    <section class="planning-intro">
      <div class="planning-season">
        <span class="planning-season-label">Saison 2026-2027</span>

        <p>
          Les cours sont organisés par tranche d’âge, dans la limite des places
          disponibles.<br />
          <b>
            Les créneaux indiqués sont susceptibles d'être adaptés en fonction
            du nombre d'inscrits.
          </b>
        </p>
      </div>
    </section>

    <!-- =========================
         PLANNING PAR JOUR
    ========================== -->

    <section class="schedule-grid">
      <!-- MARDI -->

      <article class="schedule-day">
        <header class="schedule-day-header">
          <div>
            <p class="schedule-day-label">Planning hebdomadaire</p>
            <h2>Mardi</h2>
          </div>

          <span class="schedule-day-count">4 créneaux</span>
        </header>

        <div class="schedule-table-header">
          <span>Horaire</span>
          <span>Cours</span>
          <span>Places</span>
          <span>Lieu</span>
          <span>Intervenant</span>
        </div>

        <div class="schedule-row">
          <div class="schedule-time">17h00 – 18h00</div>

          <div class="schedule-course">
            <strong>Ados</strong>
          </div>

          <div class="schedule-capacity">10 élèves</div>

          <div class="schedule-location">Maison du Bridge</div>

          <div class="schedule-teacher teacher-chris">Chris</div>
        </div>

        <div class="schedule-row">
          <div class="schedule-time">18h00 – 19h00</div>

          <div class="schedule-course">
            <strong>Adultes</strong>
          </div>

          <div class="schedule-capacity">10 élèves</div>

          <div class="schedule-location">Maison du Bridge</div>

          <div class="schedule-teacher teacher-chris">Chris</div>
        </div>

        <div class="schedule-row">
          <div class="schedule-time">19h15 – 20h30</div>

          <div class="schedule-course">
            <strong>Adultes</strong>
          </div>

          <div class="schedule-capacity">15 élèves</div>

          <div class="schedule-location">Maison du Bridge</div>

          <div class="schedule-teacher teacher-chris">Chris</div>
        </div>

        <div class="schedule-row">
          <div class="schedule-time">20h30 – 21h30</div>

          <div class="schedule-course">
            <strong>Théâtre</strong>
          </div>

          <div class="schedule-capacity">10 élèves</div>

          <div class="schedule-location">Maison du Bridge</div>

          <div class="schedule-teacher teacher-chris">Chris</div>
        </div>
      </article>

      <!-- MERCREDI -->

      <article class="schedule-day">
        <header class="schedule-day-header">
          <div>
            <p class="schedule-day-label">Planning hebdomadaire</p>
            <h2>Mercredi</h2>
          </div>

          <span class="schedule-day-count">3 créneaux</span>
        </header>

        <div class="schedule-table-header">
          <span>Horaire</span>
          <span>Cours</span>
          <span>Places</span>
          <span>Lieu</span>
          <span>Intervenant</span>
        </div>

        <div class="schedule-row">
          <div class="schedule-time">10h00 – 11h00</div>

          <div class="schedule-course">
            <strong>Enfants</strong>
          </div>

          <div class="schedule-capacity">10 élèves</div>

          <div class="schedule-location">Salle Micheline</div>

          <div class="schedule-teacher teacher-cloe">Cloé</div>
        </div>

        <div class="schedule-row">
          <div class="schedule-time">11h00 – 12h00</div>

          <div class="schedule-course">
            <strong>Enfants</strong>
          </div>

          <div class="schedule-capacity">10 élèves</div>

          <div class="schedule-location">Salle Micheline</div>

          <div class="schedule-teacher teacher-cloe">Cloé</div>
        </div>

        <div class="schedule-row">
          <div class="schedule-time">13h00 – 14h00</div>

          <div class="schedule-course">
            <strong>Enfants</strong>
          </div>

          <div class="schedule-capacity">15 élèves</div>

          <div class="schedule-location">Salle Micheline</div>

          <div class="schedule-teacher teacher-cloe">Cloé</div>
        </div>
      </article>

      <!-- JEUDI -->

      <article class="schedule-day">
        <header class="schedule-day-header">
          <div>
            <p class="schedule-day-label">Planning hebdomadaire</p>
            <h2>Jeudi</h2>
          </div>

          <span class="schedule-day-count">4 créneaux</span>
        </header>

        <div class="schedule-table-header">
          <span>Horaire</span>
          <span>Cours</span>
          <span>Places</span>
          <span>Lieu</span>
          <span>Intervenant</span>
        </div>

        <div class="schedule-row">
          <div class="schedule-time">17h00 – 18h00</div>

          <div class="schedule-course">
            <strong>Ados</strong>
          </div>

          <div class="schedule-capacity">10 élèves</div>

          <div class="schedule-location">Maison du Bridge</div>

          <div class="schedule-teacher teacher-chris">Chris</div>
        </div>

        <div class="schedule-row">
          <div class="schedule-time">18h00 – 19h00</div>

          <div class="schedule-course">
            <strong>Adultes</strong>
          </div>

          <div class="schedule-capacity">10 élèves</div>

          <div class="schedule-location">Maison du Bridge</div>

          <div class="schedule-teacher teacher-chris">Chris</div>
        </div>

        <div class="schedule-row">
          <div class="schedule-time">19h15 – 20h30</div>

          <div class="schedule-course">
            <strong>Adultes</strong>
          </div>

          <div class="schedule-capacity">15 élèves</div>

          <div class="schedule-location">Maison du Bridge</div>

          <div class="schedule-teacher teacher-chris">Chris</div>
        </div>

        <div class="schedule-row">
          <div class="schedule-time">20h30 – 21h30</div>

          <div class="schedule-course">
            <strong>Théâtre</strong>
          </div>

          <div class="schedule-capacity">10 élèves</div>

          <div class="schedule-location">Maison du Bridge</div>

          <div class="schedule-teacher teacher-chris">Chris</div>
        </div>
      </article>

      <!-- VENDREDI -->

      <article class="schedule-day">
        <header class="schedule-day-header">
          <div>
            <p class="schedule-day-label">Planning hebdomadaire</p>
            <h2>Vendredi</h2>
          </div>

          <span class="schedule-day-count">Cours individuels</span>
        </header>

        <div class="schedule-table-header">
          <span>Horaire</span>
          <span>Cours</span>
          <span>Format</span>
          <span>Lieu</span>
          <span>Intervenant</span>
        </div>

        <div class="schedule-row">
          <div class="schedule-time">17h00 – 19h00</div>

          <div class="schedule-course">
            <strong>Cours individuel</strong>
          </div>

          <div class="schedule-capacity">Tranches de 30 min</div>

          <div class="schedule-location">Salle Orient Express</div>

          <div class="schedule-teacher teacher-chris">Chris</div>
        </div>
      </article>
    </section>

    <!-- =========================
         INFORMATIONS COMPLÉMENTAIRES
    ========================== -->

    <section class="planning-notes">
      <div class="planning-note-card">
        <h2>Informations pratiques</h2>

        <p>
          Les groupes sont constitués dans la limite des places disponibles. Les
          cours individuels du vendredi sont proposés sur réservation, par
          créneaux de 30 minutes.
        </p>

        <a href="/tarifs" class="planning-cta">
          Consulter les tarifs et s’inscrire
        </a>
      </div>
    </section>
  </div>
</Layout>
