---
import Layout from "../layouts/Layout.astro";
---

<Layout title="Cours & planning - LCM">

  <!-- HEADER PAGE -->
  <section class="planning-hero scroll-reveal">
    <h1 class="planning-title">Cours & planning</h1>
    <p class="planning-subtitle">
      Découvrez nos disciplines et retrouvez les horaires par âge et par style.
    </p>
  </section>

  <!-- GRILLE DES CARTES -->
  <section class="planning-grid scroll-reveal">

    <!-- 1) Comédie musicale -->
    <article class="planning-card">
      <div class="pc-photo">
        <img src="/images/comediemusicale.jpg" alt="Cours de comédie musicale" />
      </div>
      <div class="pc-content">
        <h2 class="pc-title">Comédie musicale</h2>
        <div class="pc-meta"><span>Enseignant :</span> Machin Truc</div>

        <ul class="pc-times">
          <li><strong>Groupe ados</strong> — Lundi 18h30 – 20h30</li>
          <li><strong>Groupe adultes</strong> — Jeudi 19h00 – 21h00</li>
        </ul>
      </div>
    </article>

    <!-- 2) Chant -->
    <article class="planning-card">
      <div class="pc-photo">
        <img src="/images/chant.jpeg" alt="Cours de chant" />
      </div>
      <div class="pc-content">
        <h2 class="pc-title">Chant</h2>
        <div class="pc-meta"><span>Enseignant :</span> Machin Truc</div>

        <ul class="pc-times">
          <li><strong>Enfants</strong> — Mercredi 14h00 – 15h00</li>
          <li><strong>Ados</strong> — Mercredi 15h15 – 16h15</li>
          <li><strong>Adultes</strong> — Mercredi 18h30 – 19h30</li>
        </ul>
      </div>
    </article>

    <!-- 3) Danse -->
    <article class="planning-card">
      <div class="pc-photo">
        <img src="/images/danse.jpeg" alt="Cours de danse" />
      </div>
      <div class="pc-content">
        <h2 class="pc-title">Danse</h2>
        <div class="pc-meta"><span>Enseignant :</span> Machin Truc</div>

        <ul class="pc-times">
          <li><strong>Classique adultes</strong> — Lundi 20h00 – 21h00</li>
          <li><strong>Jazz adultes</strong> — Mardi 19h00 – 20h00</li>
          <li><strong>Classique ados</strong> — Mardi 18h00 – 19h00</li>
        </ul>
      </div>
    </article>

    <!-- 4) Théâtre -->
    <article class="planning-card">
      <div class="pc-photo">
        <img src="/images/theatre.jpg" alt="Cours de théâtre" />
      </div>
      <div class="pc-content">
        <h2 class="pc-title">Théâtre</h2>
        <div class="pc-meta"><span>Enseignant :</span> Machin Truc</div>

        <ul class="pc-times">
          <li><strong>Enfants</strong> — Samedi 10h00 – 11h00</li>
          <li><strong>Ados</strong> — Samedi 11h15 – 12h30</li>
          <li><strong>Adultes</strong> — Jeudi 18h30 – 20h00</li>
        </ul>
      </div>
    </article>

    <!-- 5) Cours particuliers -->
    <article class="planning-card">
      <div class="pc-photo">
        <img src="/images/particulier.jpeg" alt="Cours particuliers" />
      </div>
      <div class="pc-content">
        <h2 class="pc-title">Cours particuliers</h2>
        <div class="pc-meta"><span>Enseignant :</span> Machin Truc</div>

        <ul class="pc-times">
          <li><strong>Chant</strong> — Sur rendez-vous</li>
          <li><strong>Théâtre</strong> — Sur rendez-vous</li>
          <li><strong>Prépa auditions</strong> — Sur rendez-vous</li>
        </ul>
      </div>
    </article>

    <!-- 6) Éveil artistique -->
    <article class="planning-card">
      <div class="pc-photo">
        <img src="/images/eveil.jpeg" alt="Éveil artistique" />
      </div>
      <div class="pc-content">
        <h2 class="pc-title">Éveil artistique</h2>
        <div class="pc-meta"><span>Enseignant :</span> Machin Truc</div>

        <ul class="pc-times">
          <li><strong>6–8 ans</strong> — Mercredi 10h30 – 11h30</li>
          <li><strong>8–10 ans</strong> — Mercredi 11h45 – 12h45</li>
        </ul>
      </div>
    </article>

  </section>

</Layout>
