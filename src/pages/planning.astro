---
import Layout from "../layouts/Layout.astro";
---

<Layout title="Cours & planning - LCM">
  <div class="planning-page scroll-reveal">
    <!-- =========================
         EN-TÊTE DE LA PAGE
    ========================== -->

    <section class="planning-hero">
      <h1 class="planning-title">Cours & Planning</h1>

      <p class="planning-subtitle">
        Découvrez les créneaux proposés par LCM Spectacle pour la saison
        2026-2027.
      </p>
    </section>

    <!-- =========================
     ACCÈS RAPIDE
========================== -->

    <!-- =========================
     ACCÈS RAPIDE
========================== -->

    <nav class="planning-navigation" aria-label="Accès rapide">
      <a href="#infos-pratiques" class="planning-navigation-button">
        📍 Informations pratiques · Où trouver nos salles ?
      </a>
    </nav>

    <!-- =========================
         INFORMATION SAISON
    ========================== -->

    <section class="planning-intro">
      <div class="planning-season">
        <span class="planning-season-label">Saison 2026-2027</span>

        <p>
          Les cours sont organisés par tranche d’âge, dans la limite des places
          disponibles.<br />
          <b>
            Les créneaux indiqués sont susceptibles d'être adaptés en fonction
            du nombre d'inscrits.
          </b>
        </p>
      </div>
    </section>

    <!-- =========================
         PLANNING PAR JOUR
    ========================== -->

    <section class="schedule-grid">
      <!-- MARDI -->

      <article class="schedule-day">
        <header class="schedule-day-header">
          <div>
            <p class="schedule-day-label">Planning hebdomadaire</p>
            <h2>Mardi</h2>
          </div>

          <span class="schedule-day-count">4 créneaux</span>
        </header>

        <div class="schedule-table-header">
          <span>Horaire</span>
          <span>Cours</span>
          <span>Places</span>
          <span>Lieu</span>
          <span>Intervenant</span>
        </div>

        <div class="schedule-row">
          <div class="schedule-time">17h00 – 18h00</div>

          <div class="schedule-course">
            <strong>Ados</strong>
          </div>

          <div class="schedule-capacity">10 élèves</div>

          <div class="schedule-location">Maison du Bridge</div>

          <div class="schedule-teacher teacher-chris">Chris</div>
        </div>

        <div class="schedule-row">
          <div class="schedule-time">18h00 – 19h00</div>

          <div class="schedule-course">
            <strong>Adultes</strong>
          </div>

          <div class="schedule-capacity">10 élèves</div>

          <div class="schedule-location">Maison du Bridge</div>

          <div class="schedule-teacher teacher-chris">Chris</div>
        </div>

        <div class="schedule-row">
          <div class="schedule-time">19h15 – 20h30</div>

          <div class="schedule-course">
            <strong>Adultes</strong>
          </div>

          <div class="schedule-capacity">15 élèves</div>

          <div class="schedule-location">Maison du Bridge</div>

          <div class="schedule-teacher teacher-chris">Chris</div>
        </div>

        <div class="schedule-row">
          <div class="schedule-time">20h30 – 21h30</div>

          <div class="schedule-course">
            <strong>Théâtre</strong>
          </div>

          <div class="schedule-capacity">10 élèves</div>

          <div class="schedule-location">Maison du Bridge</div>

          <div class="schedule-teacher teacher-chris">Chris</div>
        </div>
      </article>

      <!-- MERCREDI -->

      <article class="schedule-day">
        <header class="schedule-day-header">
          <div>
            <p class="schedule-day-label">Planning hebdomadaire</p>
            <h2>Mercredi</h2>
          </div>

          <span class="schedule-day-count">3 créneaux</span>
        </header>

        <div class="schedule-table-header">
          <span>Horaire</span>
          <span>Cours</span>
          <span>Places</span>
          <span>Lieu</span>
          <span>Intervenant</span>
        </div>

        <div class="schedule-row">
          <div class="schedule-time">10h00 – 11h00</div>

          <div class="schedule-course">
            <strong>Enfants</strong>
          </div>

          <div class="schedule-capacity">10 élèves</div>

          <div class="schedule-location">Salle Micheline</div>

          <div class="schedule-teacher teacher-cloe">Cloé</div>
        </div>

        <div class="schedule-row">
          <div class="schedule-time">11h00 – 12h00</div>

          <div class="schedule-course">
            <strong>Enfants</strong>
          </div>

          <div class="schedule-capacity">10 élèves</div>

          <div class="schedule-location">Salle Micheline</div>

          <div class="schedule-teacher teacher-cloe">Cloé</div>
        </div>

        <div class="schedule-row">
          <div class="schedule-time">13h00 – 14h00</div>

          <div class="schedule-course">
            <strong>Enfants</strong>
          </div>

          <div class="schedule-capacity">15 élèves</div>

          <div class="schedule-location">Salle Micheline</div>

          <div class="schedule-teacher teacher-cloe">Cloé</div>
        </div>
      </article>

      <!-- JEUDI -->

      <article class="schedule-day">
        <header class="schedule-day-header">
          <div>
            <p class="schedule-day-label">Planning hebdomadaire</p>
            <h2>Jeudi</h2>
          </div>

          <span class="schedule-day-count">4 créneaux</span>
        </header>

        <div class="schedule-table-header">
          <span>Horaire</span>
          <span>Cours</span>
          <span>Places</span>
          <span>Lieu</span>
          <span>Intervenant</span>
        </div>

        <div class="schedule-row">
          <div class="schedule-time">17h00 – 18h00</div>

          <div class="schedule-course">
            <strong>Ados</strong>
          </div>

          <div class="schedule-capacity">10 élèves</div>

          <div class="schedule-location">Maison du Bridge</div>

          <div class="schedule-teacher teacher-chris">Chris</div>
        </div>

        <div class="schedule-row">
          <div class="schedule-time">18h00 – 19h00</div>

          <div class="schedule-course">
            <strong>Adultes</strong>
          </div>

          <div class="schedule-capacity">10 élèves</div>

          <div class="schedule-location">Maison du Bridge</div>

          <div class="schedule-teacher teacher-chris">Chris</div>
        </div>

        <div class="schedule-row">
          <div class="schedule-time">19h15 – 20h30</div>

          <div class="schedule-course">
            <strong>Adultes</strong>
          </div>

          <div class="schedule-capacity">15 élèves</div>

          <div class="schedule-location">Maison du Bridge</div>

          <div class="schedule-teacher teacher-chris">Chris</div>
        </div>

        <div class="schedule-row">
          <div class="schedule-time">20h30 – 21h30</div>

          <div class="schedule-course">
            <strong>Théâtre</strong>
          </div>

          <div class="schedule-capacity">10 élèves</div>

          <div class="schedule-location">Maison du Bridge</div>

          <div class="schedule-teacher teacher-chris">Chris</div>
        </div>
      </article>

      <!-- VENDREDI -->

      <article class="schedule-day">
        <header class="schedule-day-header">
          <div>
            <p class="schedule-day-label">Planning hebdomadaire</p>
            <h2>Vendredi</h2>
          </div>

          <span class="schedule-day-count">Cours individuels</span>
        </header>

        <div class="schedule-table-header">
          <span>Horaire</span>
          <span>Cours</span>
          <span>Format</span>
          <span>Lieu</span>
          <span>Intervenant</span>
        </div>

        <div class="schedule-row">
          <div class="schedule-time">17h00 – 19h00</div>

          <div class="schedule-course">
            <strong>Cours individuel</strong>
          </div>

          <div class="schedule-capacity">Tranches de 30 min</div>

          <div class="schedule-location">Salle Orient Express</div>

          <div class="schedule-teacher teacher-chris">Chris</div>
        </div>
      </article>
    </section>

    <!-- =========================
     INFORMATIONS PRATIQUES
========================== -->

    <section id="infos-pratiques" class="planning-locations">
      <div class="planning-locations-heading">
        <span class="planning-locations-eyebrow">Informations pratiques</span>

        <h2>Où trouver nos salles ?</h2>

        <p>
          Les cours de LCM sont répartis dans <strong
            >trois salles différentes</strong
          >
          à Saint-Maximin-la-Sainte-Baume selon le jour et l’horaire : la <strong
            >Salle Micheline</strong
          >, la <strong>Salle Orient Express</strong>
          et la <strong>Maison du Bridge</strong>.
        </p>
      </div>

      <div class="planning-locations-grid">
        <!-- ESPACE GARE -->
        <article class="planning-location-card">
          <div class="planning-location-content">
            <span class="planning-location-badge">Mercredi & vendredi</span>

            <h3>Espace Gare</h3>

            <p>
              La <strong>Salle Micheline</strong> et la
              <strong>Salle Orient Express</strong> se trouvent toutes les deux à
              l’Espace Gare, derrière l’Intermarché de Saint-Maximin-la-Sainte-Baume.
            </p>

            <p class="planning-location-detail">
              <strong>Salle Micheline :</strong> cours du mercredi<br />
              <strong>Salle Orient Express :</strong> cours individuels du vendredi
            </p>

            <p class="planning-location-warning">
              📍 Les coordonnées précises de l’Espace Gare seront ajoutées
              prochainement. La carte indique pour le moment l’Intermarché situé
              juste devant.
            </p>
          </div>

          <div class="planning-map">
            <iframe
              src="https://www.google.com/maps?q=Intermarch%C3%A9%20Saint-Maximin-la-Sainte-Baume&output=embed"
              title="Espace Gare à Saint-Maximin-la-Sainte-Baume"
              loading="lazy"
              referrerpolicy="no-referrer-when-downgrade"></iframe>
          </div>
        </article>

        <!-- MAISON DU BRIDGE -->
        <article class="planning-location-card">
          <div class="planning-location-content">
            <span class="planning-location-badge">Mardi & jeudi</span>

            <h3>Maison du Bridge</h3>

            <p>
              Les cours du mardi et du jeudi ont lieu à la
              <strong>Maison du Bridge</strong>.
            </p>

            <p class="planning-location-detail">
              <strong>Adresse :</strong><br />
              491 avenue des Cinq Ponts<br />
              83470 Saint-Maximin-la-Sainte-Baume
            </p>

            <a
              href="https://www.google.com/maps/place//data=!4m2!3m1!1s0x12c9719007708887:0x21ad29a309686ae5?sa=X&ved=1t:8290&ictx=111"
              target="_blank"
              rel="noopener noreferrer"
              class="planning-map-link"
            >
              Ouvrir dans Google Maps ↗
            </a>
          </div>

          <div class="planning-map">
            <iframe
              src="https://www.google.com/maps?q=491%20Avenue%20des%20Cinq%20Ponts%2083470%20Saint-Maximin-la-Sainte-Baume&output=embed"
              title="Maison du Bridge à Saint-Maximin-la-Sainte-Baume"
              loading="lazy"
              referrerpolicy="no-referrer-when-downgrade"></iframe>
          </div>
        </article>
      </div>

      <div class="planning-locations-action">
        <a href="/tarifs" class="planning-cta">
          Consulter les tarifs et s’inscrire
        </a>
      </div>
    </section>
  </div>
</Layout>
